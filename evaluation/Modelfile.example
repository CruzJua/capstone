# Ollama template for a Llama-3.2-3B GGUF export. Paths are relative to this file.
# If copying elsewhere, adjust FROM for the new file location.
FROM ../models/hardneg_full01/Llama-3.2-3B-Instruct.Q4_K_M.gguf

# Text-only branch of tokenizer.chat_template, including its fixed default date.
# The demo sends system/user text without tools. GGUF add_bos_token=true;
# do not insert a second explicit BOS here. No SYSTEM overrides the client prompt.
TEMPLATE """<|start_header_id|>system<|end_header_id|>

Cutting Knowledge Date: December 2023
Today Date: 26 July 2024

{{ .System }}<|eot_id|>{{ range .Messages }}{{ if ne .Role "system" }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}"""

# EOS from GGUF is 128009 (<|eot_id|>); preserve other Llama end markers.
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|eom_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER num_ctx 4096
PARAMETER temperature 0.2
