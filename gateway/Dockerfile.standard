FROM node:22-bookworm-slim AS node-runtime

FROM node-runtime AS widget-build
WORKDIR /widget
COPY widget/package.json widget/package-lock.json ./
RUN npm ci --ignore-scripts
COPY widget/vite.config.js ./
COPY widget/src ./src
RUN npm run build:embed

FROM python:3.14-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHON_EXECUTABLE=/opt/venv/bin/python \
    HF_HOME=/cache/huggingface \
    PATH="/opt/venv/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && python -m venv /opt/venv
# Embeddings run on CPU independently of Ollama's inference device.
# Every package, including the CPU-only torch wheel, is pinned with hashes in the lock;
# the PyTorch index is consulted only for the +cpu build and everything else comes from PyPI.
COPY deployment/requirements.cpu.lock /tmp/requirements.cpu.lock
RUN pip install --require-hashes --no-deps \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r /tmp/requirements.cpu.lock \
    && python -c "import torch, sentence_transformers, pymongo, ollama, pydantic; assert torch.version.cuda is None" \
    && rm /tmp/requirements.cpu.lock
WORKDIR /app
COPY gateway/package.json gateway/package-lock.json ./gateway/
RUN cd gateway && npm ci --omit=dev
COPY gateway/src ./gateway/src
COPY src ./src
COPY scripts ./scripts
# gateway/src/config/presets.js reads this manifest at startup, even in standard mode, to
# reserve the preset tenant IDs. Only the manifest is copied: no tenant documents or datasets.
COPY data/fixtures/demo_manifest.json ./data/fixtures/demo_manifest.json
COPY --from=widget-build /widget/dist/widget.js ./widget/dist/widget.js
RUN mkdir -p /tmp/capstone_uploads /cache/huggingface
WORKDIR /app/gateway
EXPOSE 4000
CMD ["node", "src/server.js"]
