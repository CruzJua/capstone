# Google Gemini API Key for Teacher Model Data Generation & Caching
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Configuration for RAG Document Store & Vector Search
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?
MONGODB_DB_NAME=rag_knowledge_base
MONGODB_TRAINING_DB_NAME=capstone_dev
MONGODB_COLLECTION_NAME=doc_vectors
MONGODB_VECTOR_INDEX_NAME=vector_index

# Orchestration Gateway Mode ("standard" default, or "preset_training" for one-click synthetic demo tenants)
# For the self-contained Docker local demo (no Atlas required), see .env.demo.example and scripts/setup_demo.sh
# SESSION_COOKIE_NAME=capstone_session
# UPLOAD_STAGING_DIR=/tmp/uploads
APP_MODE=standard

# (Optional) Embedding Model configuration (default: BAAI/bge-small-en-v1.5)
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Local chat demo / generation evaluation (uses an already installed Ollama model)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Gateway listen port (default 4000). The gateway and the chat service read this file automatically;
# variables already exported in your shell take precedence over it (see gateway/README.md section 1B).
# PORT=4000

# Embeddable chat widget (gateway POST /api/chat and GET /widget.js; see gateway/README.md section 5)
# Origins a browser page may embed the widget from, for tenants that have no
# widget_config.allowed_origins of their own. Leave unset in production: unset means "reject".
# This is a LOCAL DEVELOPMENT value; tenants should list their real origins on their business record.
WIDGET_DEFAULT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Internal chat service (scripts/run_chat_service.py) that the gateway calls, and its shared secret.
# CHAT_BACKEND_URL=http://127.0.0.1:8100
# CHAT_BACKEND_TOKEN=change_me_when_the_service_is_reachable_from_another_host
