{
    "name": "selfhost-support-widget",
    "version": "0.1.0",
    "type": "module",
    "description": "Embeddable chat widget for a self-hosted, multi-tenant support gateway. Use it as a <script> tag or as a React component.",
    "license": "MIT",
    "author": "Juan Cruz",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CruzJua/capstone.git",
        "directory": "widget"
    },
    "homepage": "https://github.com/CruzJua/capstone/tree/main/widget#readme",
    "bugs": {
        "url": "https://github.com/CruzJua/capstone/issues"
    },
    "keywords": ["chat", "widget", "support", "customer-support", "react", "sse", "self-hosted"],
    "main": "./dist/lib/index.js",
    "module": "./dist/lib/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/lib/index.js"
        },
        "./widget.js": "./dist/widget.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "types",
        "README.md",
        "LICENSE",
        "API_CONTRACT.md"
    ],
    "sideEffects": false,
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --mode lib",
        "build:embed": "vite build",
        "build:lib": "vite build --mode lib",
        "mock": "node mock/mock_gateway.js",
        "test": "node --test tests/*.test.js",
        "prepublishOnly": "npm test && npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.0.0",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "vite": "^7.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
