# Generate the private .env.compose.local with scripts/setup_stack.py.
# Values here are placeholders; never reuse them as installation secrets.
MONGO_ROOT_USER=capstone_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
MONGODB_DB_NAME=rag_knowledge_base
CHAT_BACKEND_TOKEN=REPLACE_WITH_RANDOM_HEX
CHAT_FOLLOW_UP_SECRET=REPLACE_WITH_RANDOM_HEX

# Absolute external directory containing Llama-3.2-3B-Instruct.Q4_K_M.gguf.
MODEL_GGUF_DIR=/absolute/path/to/external/hardneg_full01
MODEL_GGUF_SHA256=REPLACE_WITH_VERIFIED_SHA256
OLLAMA_MODEL=llama3.2:3b-qlora-hardneg-full01-q4
OLLAMA_IMAGE=ollama/ollama:0.40.16

# Browser-facing addresses, not Compose service DNS names.
GATEWAY_PORT=4002
DASHBOARD_PORT=3002
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4002
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
SESSION_COOKIE_NAME=capstone_sprint6_session
