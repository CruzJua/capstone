# ==============================================================================
# CAPSTONE PORTABLE LOCAL DEMO CONFIGURATION (.env.demo.example)
# ==============================================================================
# Copy this file to .env.demo.local or let `bash scripts/setup_demo.sh` generate
# .env.demo.local automatically with locally generated credentials.
# Never commit .env.demo.local or reuse live MongoDB Atlas credentials here.

# 1. Mode & Database Isolation
APP_MODE="preset_training"
MONGODB_DB_NAME="rag_knowledge_base"
MONGODB_TRAINING_DB_NAME="capstone_demo"
MONGODB_COLLECTION_NAME="doc_vectors"

# 2. Local MongoDB Atlas (Vector Search) Credentials & Ports
DEMO_MONGO_USER="demo_admin"
DEMO_MONGO_PASSWORD="demo_local_only_password"
DEMO_MONGO_PORT="27018"

# Container-internal and host-loopback MongoDB URIs
MONGODB_URI="mongodb://demo_admin:demo_local_only_password@mongodb-demo:27017/?directConnection=true&authSource=admin"
DEMO_HOST_MONGODB_URI="mongodb://demo_admin:demo_local_only_password@127.0.0.1:27018/?directConnection=true&authSource=admin"

# 3. Gateway & Dashboard Loopback Ports and Session Isolation
DEMO_GATEWAY_PORT="4001"
DEMO_DASHBOARD_PORT="3001"
SESSION_COOKIE_NAME="capstone_demo_session"
UPLOAD_STAGING_DIR="/tmp/capstone_demo_uploads"
ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4001"

# 4. Local Embedding & Inference Configuration
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
OLLAMA_HOST="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3.2:3b"

